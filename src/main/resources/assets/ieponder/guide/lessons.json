[
  {
    "id": "coke_oven",
    "chapter": "start",
    "title": {
      "ja": "コークス炉の組み立て",
      "en": "Building a Coke Oven"
    },
    "summary": {
      "ja": "27個のレンガから、コークスとクレオソート油の生産を始めます",
      "en": "A 27-brick oven supplies Coal Coke and Creosote Oil"
    },
    "icon": "immersiveengineering:cokebrick",
    "components": [
      "immersiveengineering:cokebrick",
      "immersiveengineering:coal_coke",
      "immersiveengineering:creosote_bucket",
      "immersiveengineering:coke_oven"
    ],
    "nodes": [],
    "steps": [
      {
        "text": {
          "ja": "コークス炉用レンガを3×3に並べた層が底面になります\n電力は不要です",
          "en": "A 3 by 3 layer of Coke Bricks forms the base\nThe oven does not need electricity"
        },
        "show": [
          "@layer0"
        ],
        "focus": [
          "mb_1_0_2"
        ],
        "callouts": [
          {
            "item": "immersiveengineering:cokebrick",
            "anchor": "mb_1_0_2",
            "action": "none"
          }
        ]
      },
      {
        "text": {
          "ja": "中央の層にも9個のレンガを使います\n中央を空洞にせず、合計27個で組みます",
          "en": "The middle layer uses nine more bricks\nThe center stays solid: the full structure uses 27 bricks"
        },
        "show": [
          "@layer1"
        ],
        "focus": [
          "mb_1_1_1"
        ]
      },
      {
        "text": {
          "ja": "上段を埋め、エンジニアのハンマーで側面中央を右クリックすると形成します\n模型は組み立て前の配置を示しています",
          "en": "A full top layer completes the brick layout\nRight-clicking a side's center with an Engineer's Hammer forms the oven\nThis model shows the construction layout"
        },
        "show": [
          "@layer2"
        ],
        "focus": [
          "mb_1_1_2"
        ],
        "callouts": [
          {
            "item": "immersiveengineering:hammer",
            "anchor": "mb_1_1_2",
            "action": "right_click"
          }
        ]
      },
      {
        "text": {
          "ja": "完成後の画面に石炭を入れると、コークスとクレオソート油を得られます\n木材の処理にも対応します",
          "en": "Coal in the formed oven's interface produces Coal Coke and Creosote Oil\nRecipes also exist for logs"
        },
        "focus": [
          "mb_1_1_2"
        ],
        "callouts": [
          {
            "item": "minecraft:coal",
            "anchor": "mb_1_1_2",
            "action": "none"
          },
          {
            "item": "immersiveengineering:coal_coke",
            "anchor": "mb_1_1_2",
            "action": "none"
          }
        ]
      },
      {
        "text": {
          "ja": "油が満杯になると処理が止まります\n容器や液体ポンプで回収してください\n油は防腐木材の材料になります",
          "en": "A full oil tank stops processing\nDrain it with containers or a Fluid Pump\nThe creosote is used to make treated wood"
        },
        "focus": [
          "mb_1_1_2"
        ],
        "callouts": [
          {
            "item": "immersiveengineering:creosote_bucket",
            "anchor": "mb_1_1_2",
            "action": "none"
          }
        ],
        "warning": true
      }
    ],
    "structure": {
      "template": "coke_oven",
      "origin": [
        3,
        1,
        3
      ]
    }
  },
  {
    "id": "alloy_kiln",
    "chapter": "start",
    "title": {
      "ja": "合金窯の組み立て",
      "en": "Building an Alloy Kiln"
    },
    "summary": {
      "ja": "2×2×2の窯で、燃料と2種類の材料から合金を作ります",
      "en": "A 2 by 2 by 2 kiln combines two ingredients with furnace fuel"
    },
    "icon": "immersiveengineering:alloybrick",
    "components": [
      "immersiveengineering:alloybrick",
      "immersiveengineering:ingot_electrum",
      "immersiveengineering:ingot_constantan",
      "immersiveengineering:alloy_smelter"
    ],
    "nodes": [],
    "steps": [
      {
        "text": {
          "ja": "耐熱レンガを2×2に並べた層が底面です\n合金窯は電力ではなく、かまど用の燃料を使います",
          "en": "A 2 by 2 layer of Kiln Bricks forms the base\nAn Alloy Kiln uses furnace fuel rather than electricity"
        },
        "show": [
          "@layer0"
        ],
        "focus": [
          "mb_0_0_1"
        ],
        "callouts": [
          {
            "item": "immersiveengineering:alloybrick",
            "anchor": "mb_0_0_1",
            "action": "none"
          }
        ]
      },
      {
        "text": {
          "ja": "上にもう4個を重ねた、合計8個の2×2×2の立方体です",
          "en": "Four more bricks on top complete a solid 2 by 2 by 2 cube of eight bricks"
        },
        "show": [
          "@layer1"
        ],
        "focus": [
          "mb_0_1_1"
        ]
      },
      {
        "text": {
          "ja": "側面をエンジニアのハンマーで右クリックすると合金窯になります\nこの模型は形成に必要な配置です",
          "en": "Right-clicking a side with the Engineer's Hammer forms the kiln\nThe model shows the blocks required for construction"
        },
        "focus": [
          "mb_1_1_1"
        ],
        "callouts": [
          {
            "item": "immersiveengineering:hammer",
            "anchor": "mb_1_1_1",
            "action": "right_click"
          }
        ]
      },
      {
        "text": {
          "ja": "合金窯はレシピで指定された2種類の材料と燃料を使います\n金と銀からはエレクトラムを作れます",
          "en": "The kiln combines two recipe ingredients using fuel\nGold and silver, for example, make Electrum"
        },
        "focus": [
          "mb_0_0_1"
        ],
        "callouts": [
          {
            "item": "minecraft:gold_ingot",
            "anchor": "mb_0_0_1",
            "action": "none"
          },
          {
            "item": "immersiveengineering:ingot_silver",
            "anchor": "mb_0_0_1",
            "action": "none"
          },
          {
            "item": "immersiveengineering:ingot_electrum",
            "anchor": "mb_0_0_1",
            "action": "none"
          }
        ]
      },
      {
        "text": {
          "ja": "材料の組み合わせと個数は現在の環境のレシピを確認してください\n出力欄が埋まった場合も取り出す必要があります",
          "en": "Check the active recipes for ingredient combinations and quantities\nClear the output slot when it fills"
        },
        "focus": [
          "mb_0_0_1"
        ],
        "warning": true
      }
    ],
    "structure": {
      "template": "alloy_smelter",
      "origin": [
        3,
        1,
        3
      ]
    }
  },
  {
    "id": "basic_wiring",
    "chapter": "power",
    "title": {
      "ja": "低圧配線と継電器",
      "en": "LV wiring and relays"
    },
    "summary": {
      "ja": "接続端子と継電器を使い分け、ワイヤーを2点に接続します",
      "en": "Two endpoints connect by wire, using connectors at devices and relays at junctions"
    },
    "icon": "immersiveengineering:connector_lv",
    "components": [
      "immersiveengineering:connector_lv",
      "immersiveengineering:connector_lv_relay",
      "immersiveengineering:wirecoil_copper",
      "immersiveengineering:wirecoil_copper_ins",
      "immersiveengineering:wirecutter"
    ],
    "nodes": [
      {
        "id": "source",
        "block": "immersiveengineering:capacitor_lv",
        "pos": [
          2,
          1,
          4
        ],
        "nbt": "{sideConfig_0:0,sideConfig_1:2,sideConfig_2:0,sideConfig_3:0,sideConfig_4:0,sideConfig_5:0}"
      },
      {
        "id": "source_plug",
        "block": "immersiveengineering:connector_lv",
        "pos": [
          2,
          2,
          4
        ],
        "state": {
          "facing": "down"
        }
      },
      {
        "id": "pole",
        "block": "immersiveengineering:treated_wood_horizontal",
        "pos": [
          4,
          1,
          4
        ]
      },
      {
        "id": "relay",
        "block": "immersiveengineering:connector_lv_relay",
        "pos": [
          4,
          2,
          4
        ],
        "state": {
          "facing": "down"
        }
      },
      {
        "id": "target",
        "block": "immersiveengineering:capacitor_lv",
        "pos": [
          6,
          1,
          4
        ]
      },
      {
        "id": "target_plug",
        "block": "immersiveengineering:connector_lv",
        "pos": [
          6,
          2,
          4
        ],
        "state": {
          "facing": "down"
        }
      }
    ],
    "steps": [
      {
        "text": {
          "ja": "装置と電力をやり取りする場所には低圧線接続端子を使います\n端子を付けた面は、装置側でも入出力を設定します",
          "en": "LV Wire Connectors exchange power with devices\nThe device side beneath each connector needs the intended input or output setting"
        },
        "show": [
          "source",
          "source_plug",
          "target",
          "target_plug"
        ],
        "focus": [
          "source_plug"
        ],
        "callouts": [
          {
            "item": "immersiveengineering:connector_lv",
            "anchor": "source_plug",
            "action": "none"
          }
        ]
      },
      {
        "text": {
          "ja": "途中の分岐には低圧線継電器を使います\n継電器はワイヤーを中継しますが、土台の装置に電力を渡しません",
          "en": "An LV Wire Relay serves as a junction\nRelays join wires but do not exchange power with the block supporting them"
        },
        "show": [
          "pole",
          "relay"
        ],
        "focus": [
          "relay"
        ],
        "callouts": [
          {
            "item": "immersiveengineering:connector_lv_relay",
            "anchor": "relay",
            "action": "none"
          }
        ]
      },
      {
        "text": {
          "ja": "低圧ワイヤーの束で端子、継電器の順に右クリックすると接続します\n線は接続経路を示す説明用の表示です",
          "en": "An LV Wire Coil connects a connector and relay when each is right-clicked in turn\nThe animated line illustrates the connection path"
        },
        "focus": [
          "source_plug",
          "relay"
        ],
        "callouts": [
          {
            "item": "immersiveengineering:wirecoil_copper",
            "anchor": "source_plug",
            "action": "right_click"
          },
          {
            "item": "immersiveengineering:wirecoil_copper",
            "anchor": "relay",
            "action": "right_click"
          }
        ],
        "flow": {
          "from": "source_plug",
          "to": "relay",
          "item": "immersiveengineering:wirecoil_copper"
        }
      },
      {
        "text": {
          "ja": "同じ操作で継電器から受電側の端子へも接続します\n端子・継電器とワイヤーは同じ電圧を使います",
          "en": "The same action connects the relay to the receiving connector\nThe wire, connectors and relay need matching voltage tiers"
        },
        "focus": [
          "relay",
          "target_plug"
        ],
        "callouts": [
          {
            "item": "immersiveengineering:wirecoil_copper",
            "anchor": "target_plug",
            "action": "right_click"
          }
        ],
        "flow": {
          "from": "relay",
          "to": "target_plug",
          "item": "immersiveengineering:wirecoil_copper"
        }
      },
      {
        "text": {
          "ja": "ワイヤーに障害物が重なると接続できません\n生物に触れる場所では被覆済みワイヤーを使い、切断にはワイヤーカッターを使ってください",
          "en": "Blocks obstructing the wire path prevent a connection\nUse insulated wire where creatures could touch it\nA Wirecutter removes a connection"
        },
        "focus": [
          "relay"
        ],
        "callouts": [
          {
            "item": "immersiveengineering:wirecoil_copper_ins",
            "anchor": "relay",
            "action": "none"
          },
          {
            "item": "immersiveengineering:wirecutter",
            "anchor": "relay",
            "action": "right_click"
          }
        ],
        "warning": true
      }
    ]
  },
  {
    "id": "capacitors",
    "chapter": "power",
    "title": {
      "ja": "キャパシタの面設定",
      "en": "Configuring capacitor sides"
    },
    "summary": {
      "ja": "青の入力、橙の出力、無効の面をハンマーで切り替えます",
      "en": "The hammer switches capacitor faces between blue input, orange output and disabled"
    },
    "icon": "immersiveengineering:capacitor_lv",
    "components": [
      "immersiveengineering:capacitor_lv",
      "immersiveengineering:capacitor_mv",
      "immersiveengineering:capacitor_hv",
      "immersiveengineering:hammer"
    ],
    "nodes": [
      {
        "id": "buffer",
        "block": "immersiveengineering:capacitor_lv",
        "pos": [
          4,
          1,
          4
        ],
        "nbt": "{sideConfig_0:0,sideConfig_1:1,sideConfig_2:0,sideConfig_3:0,sideConfig_4:0,sideConfig_5:0}"
      },
      {
        "id": "input",
        "block": "immersiveengineering:connector_lv",
        "pos": [
          4,
          2,
          4
        ],
        "state": {
          "facing": "down"
        }
      },
      {
        "id": "output",
        "block": "immersiveengineering:connector_lv",
        "pos": [
          5,
          1,
          4
        ],
        "state": {
          "facing": "west"
        }
      }
    ],
    "steps": [
      {
        "text": {
          "ja": "キャパシタは発電と消費の間で電力を蓄えます\n低・中・高電圧で容量と入出力上限が異なります",
          "en": "A capacitor buffers energy between generation and consumption\nLV, MV and HV variants have different capacities and transfer limits"
        },
        "show": [
          "buffer"
        ],
        "focus": [
          "buffer"
        ],
        "callouts": [
          {
            "item": "immersiveengineering:capacitor_lv",
            "anchor": "buffer",
            "action": "none"
          }
        ]
      },
      {
        "text": {
          "ja": "青い面は入力です\nエンジニアのハンマーで面を右クリックすると、入力・出力・無効を切り替えられます",
          "en": "Blue marks an input\nRight-clicking a face with the Engineer's Hammer changes its setting\nThis cycles its input, output and disabled settings"
        },
        "show": [
          "input"
        ],
        "focus": [
          "buffer"
        ],
        "callouts": [
          {
            "item": "immersiveengineering:hammer",
            "anchor": "buffer",
            "action": "right_click"
          }
        ]
      },
      {
        "text": {
          "ja": "橙の面は出力です\n発電側から入力へ、出力から消費側へ電力が流れます\n接続端子だけでは面設定は変わりません",
          "en": "Orange marks an output\nPower flows from the generator to an input, then from an output to the consumer\nAdding a connector does not configure the capacitor face"
        },
        "show": [
          "output"
        ],
        "focus": [
          "buffer",
          "output"
        ],
        "nbt": {
          "buffer": "{sideConfig_5:2}"
        }
      },
      {
        "text": {
          "ja": "スニークしながらハンマーを使うと、クリックした面の反対側を設定できます\n色のない面は接続を受け付けません",
          "en": "Sneaking while using the hammer configures the opposite face\nFaces without a color marking do not accept a connection"
        },
        "focus": [
          "buffer"
        ],
        "callouts": [
          {
            "item": "immersiveengineering:hammer",
            "anchor": "buffer",
            "action": "right_click",
            "sneak": true
          }
        ],
        "warning": true
      },
      {
        "text": {
          "ja": "蓄電があっても出力上限を超えて供給できません\n装置が止まるときは残量と面設定、電圧、転送上限を確認してください",
          "en": "Stored energy cannot bypass the output limit\nIf a machine stops, check stored energy and side settings\nAlso check its voltage tier and transfer limits"
        },
        "focus": [
          "buffer"
        ],
        "warning": true
      }
    ]
  },
  {
    "id": "thermoelectric",
    "chapter": "power",
    "title": {
      "ja": "温度差による発電",
      "en": "Generating power from temperature"
    },
    "summary": {
      "ja": "熱源と冷却源を向かい合わせ、熱電発電機から電力を取り出します",
      "en": "Opposite hot and cold sources power a Thermoelectric Generator"
    },
    "icon": "immersiveengineering:thermoelectric_generator",
    "components": [
      "immersiveengineering:thermoelectric_generator"
    ],
    "nodes": [
      {
        "id": "gen",
        "block": "immersiveengineering:thermoelectric_generator",
        "pos": [
          4,
          1,
          4
        ]
      },
      {
        "id": "hot",
        "block": "minecraft:magma_block",
        "pos": [
          3,
          1,
          4
        ]
      },
      {
        "id": "cold",
        "block": "minecraft:blue_ice",
        "pos": [
          5,
          1,
          4
        ]
      },
      {
        "id": "plug",
        "block": "immersiveengineering:connector_lv",
        "pos": [
          4,
          2,
          4
        ],
        "state": {
          "facing": "down"
        }
      }
    ],
    "steps": [
      {
        "text": {
          "ja": "熱電発電機は、向かい合う2面の温度差から発電します\n燃料や回転軸を必要としません",
          "en": "The Thermoelectric Generator uses a temperature difference to generate power\nThe hot and cold sources must touch two opposite faces\nIt needs neither fuel nor a rotating shaft"
        },
        "show": [
          "gen"
        ],
        "focus": [
          "gen"
        ],
        "callouts": [
          {
            "item": "immersiveengineering:thermoelectric_generator",
            "anchor": "gen",
            "action": "none"
          }
        ]
      },
      {
        "text": {
          "ja": "熱源と冷たいブロックを、発電機を挟んで向かい合わせます\nここではマグマブロックと青氷を示しています",
          "en": "The hot and cold sources sit on opposite sides of the generator\nThis example uses a Magma Block and Blue Ice"
        },
        "show": [
          "hot",
          "cold"
        ],
        "focus": [
          "hot",
          "cold"
        ],
        "callouts": [
          {
            "item": "minecraft:magma_block",
            "anchor": "hot",
            "action": "none"
          },
          {
            "item": "minecraft:blue_ice",
            "anchor": "cold",
            "action": "none"
          }
        ]
      },
      {
        "text": {
          "ja": "発電機に付けた接続端子から、電力を使う装置へ配線します\n上下の対向面でも温度差を利用できます",
          "en": "A wire connector on the generator supplies a wired consumer\nOpposite faces above and below the generator can also provide a temperature gradient"
        },
        "show": [
          "plug"
        ],
        "focus": [
          "plug"
        ],
        "callouts": [
          {
            "item": "immersiveengineering:connector_lv",
            "anchor": "plug",
            "action": "none"
          }
        ]
      },
      {
        "text": {
          "ja": "熱源と冷却源が隣り合う配置では、その2つの差を使えません\n発電機を挟んで向かい合う配置が必要です",
          "en": "Sources on adjacent sides do not form a temperature pair\nThe generator needs to sit directly between the hot and cold sources"
        },
        "focus": [
          "hot",
          "cold"
        ],
        "warning": true
      },
      {
        "text": {
          "ja": "発電量は温度差と設定で変わります\n受電先や配線の上限も確認し、一定の発電量を前提にしないでください",
          "en": "Output depends on the temperature difference and configuration\nCheck the receiving network and its limits instead of assuming a fixed output"
        },
        "focus": [
          "gen"
        ],
        "warning": true
      }
    ]
  },
  {
    "id": "water_wheel",
    "chapter": "power",
    "title": {
      "ja": "水車と動力ダイナモ",
      "en": "Waterwheel and Kinetic Dynamo"
    },
    "summary": {
      "ja": "先にダイナモを置き、軸に水車を取り付けて水流を利用します",
      "en": "The dynamo goes down first, then a waterwheel attaches to its shaft and turns with flowing water"
    },
    "icon": "immersiveengineering:watermill",
    "components": [
      "immersiveengineering:watermill",
      "immersiveengineering:dynamo"
    ],
    "nodes": [
      {
        "id": "dynamo",
        "block": "immersiveengineering:dynamo",
        "pos": [
          4,
          3,
          4
        ],
        "state": {
          "facing": "east"
        }
      },
      {
        "id": "wheel",
        "block": "immersiveengineering:watermill",
        "pos": [
          5,
          3,
          4
        ],
        "state": {
          "facing": "west"
        }
      },
      {
        "id": "water",
        "block": "minecraft:water",
        "pos": [
          5,
          5,
          3
        ]
      },
      {
        "id": "plug",
        "block": "immersiveengineering:connector_lv",
        "pos": [
          4,
          4,
          4
        ],
        "state": {
          "facing": "down"
        }
      }
    ],
    "steps": [
      {
        "text": {
          "ja": "先に設置する動力ダイナモの軸を、水車の位置へ向けます\n電力はダイナモから取り出します",
          "en": "The Kinetic Dynamo goes down first, with its shaft facing the planned wheel\nElectrical power comes from the dynamo"
        },
        "show": [
          "dynamo"
        ],
        "focus": [
          "dynamo"
        ],
        "callouts": [
          {
            "item": "immersiveengineering:dynamo",
            "anchor": "dynamo",
            "action": "none"
          }
        ]
      },
      {
