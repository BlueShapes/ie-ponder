* text=auto
*.java text eol=lf
*.py text eol=lf
*.gradle text eol=lf
*.md text eol=lf
*.toml text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf

# Translation review hashes cover exact JSON bytes; preserve their line endings.
*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.nbt binary
*.jar binary
